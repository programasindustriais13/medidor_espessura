# ==============================================================================
# ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE - MEDIDOR DE ESPESSURA (Med_espessura)
# Copie este arquivo para .env e preencha com as credenciais do seu ambiente.
# ==============================================================================

# ── Configurações Gerais do Django ──────────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ── Origem de Dados do Scada (Feature Flag para Rollback Imediato) ───────────
# Opções: 'mysql' ou 'rest_api'
# Se o MySQL estiver indisponível ou inacessível na rede, o sistema pode alternar
# instantaneamente para 'rest_api' sem alterar nenhuma linha de código.
SCADA_DATA_SOURCE=rest_api

# ── Conexão Secundária MySQL Scada-LTS (Estritamente Somente-Leitura) ────────
# O usuário DEVE possuir estritamente privilégios de SELECT nas tabelas:
# datapoints, pointvalues e pointvalueannotations.
# NUNCA utilizar usuário root ou com privilégios de escrita.
SCADA_DB_ENGINE=django.db.backends.mysql
SCADA_DB_NAME=scadalts
SCADA_DB_USER=scada_monitor_ro
SCADA_DB_PASSWORD=sua_senha
SCADA_DB_HOST=127.0.0.1
SCADA_DB_PORT=3306
SCADA_DB_CONNECT_TIMEOUT=5

# ── Conexão REST Legada do Scada-LTS (Fallback / Origem Operacional Atual) ───
SCADA_REST_BASE_URL=http://192.168.0.202:8080/Scada-LTS
SCADA_REST_USERNAME=tatd
SCADA_REST_PASSWORD=ttedt

# ── Tags / XIDs Padrão do Processo ──────────────────────────────────────────
SCADA_XID_GATILHO=DP_887366
SCADA_XID_MEDICAO=DP_747174

# ── Controle de Ingestão e Concorrência ─────────────────────────────────────
# Se 'True', AppConfig tenta inicializar worker em segundo plano no runserver.
# Padrão recomendado em produção: 'False' (usar 'python manage.py collect_scada')
SCADA_AUTO_WORKER=False
